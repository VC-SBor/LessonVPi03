# === ВКонтакте ===
# Токен сообщества: Управление сообществом → Рабочий стол → Работа с API → Ключи доступа
VK_TOKEN=

# === ProxyAPI ===
# Ключ API: https://console.proxyapi.ru → раздел «API-ключи»
PROXYAPI_KEY=

# Модель (короткое имя работает на /v1/chat/completions)
AI_MODEL=gpt-4.1-mini

# Базовый URL ProxyAPI
AI_BASE_URL=https://api.proxyapi.ru/v1

# Системный промпт (пусто = встроенный)
AI_SYSTEM_PROMPT=

# Сколько последних пар реплик хранить в истории каждого диалога
AI_HISTORY_LIMIT=10
